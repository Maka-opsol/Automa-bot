{
  "name": "mathu-bot",
  "version": "6.0.0",
  "description": "Autonomous bot for MathU educational platform with self-improvement, experimentation, and cross-domain capabilities",
  "main": "hf-spaces.ts",
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=3584 --import tsx hf-spaces.ts",
    "start:agent": "node --import tsx --expose-gc --max-old-space-size=512 agent.ts",
    "start:tsx": "node --import tsx --expose-gc --max-old-space-size=512 agent.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir .",
    "test:integration": "vitest run test-integration.test.js",
    "typecheck": "tsc --noEmit",
    "watchdog": "node --import tsx watchdog.ts",
    "postinstall": "node postinstall.js",
    "dashboard": "node --import tsx dashboard-server.ts",
    "validate": "node test-validation-suite.js",
    "lint": "echo \"No linter configured yet\" && exit 0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.0",
    "@libsql/client": "^0.14.0",
    "better-sqlite3": "^9.0.0",
    "tsx": "^4.0.0",
    "date-fns": "^3.6.0",
    "envalid": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.0.1",
    "nerdamer": "^1.1.13",
    "pino": "^8.17.2",
    "pino-roll": "^3.0.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "U.S.J Sibiya",
  "license": "MIT",
  "_dependencyNotes": {
    "tsx": "Intentionally in production dependencies: worker threads use --import tsx in tsx-mode (start:tsx, watchdog, dashboard scripts). Not moved to devDependencies because compiled mode still requires tsx for development workflows."
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.7.0",
    "node-telegram-bot-api": "^0.64.0",
    "nodemailer": "^6.9.7",
    "onnxruntime-node": "^1.15.0",
    "sharp": "^0.33.2",
    "tesseract.js": "^4.1.1"
  }
}
