# ═══════════════════════════════════════════════════════════════════════════
# MathU Bot v5 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Required fields are marked [REQUIRED]. Everything else has sensible defaults.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Node.js ──────────────────────────────────────────────────────────────
# Must be >= 20.6.0 (required for --import tsx flag)
NODE_ENV=development

# ─── Microsoft Credentials [REQUIRED] ──────────────────────────────────────
# Plain text or AES-256-GCM encrypted (then ENCRYPTION_PASSPHRASE is required)
MICROSOFT_EMAIL=your-email@example.com
MICROSOFT_PASSWORD=your-password

# ─── Credential Encryption (optional) ─────────────────────────────────────
# Set if credentials above are encrypted. Must be >= 16 characters.
# ENCRYPTION_PASSPHRASE=

# ─── Vision AI Provider API Keys ──────────────────────────────────────────
# At least ONE of these is required for the bot to function.
# Set the key(s) for the provider(s) you want to use.

# GitHub Models (free tier available)
GITHUB_API_KEY=

# Groq (free tier available)
GROQ_API_KEY=

# z.ai
ZAI_API_KEY=

# Agnes AI
AGNES_API_KEY=

# NVIDIA
NVIDIA_API_KEY=

# Cloudflare Workers AI (requires both)
CF_API_KEY=
CF_ACCOUNT_ID=

# Cerebras
CEREBRAS_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ─── Code-Generation API Keys (for self-heal) ─────────────────────────────
# At least one recommended for self-heal patch generation.
MISTRAL_CODE_API_KEY=
QWEN_CODE_API_KEY=
DEEPSEEK_CODE_API_KEY=
OPENROUTER_API_KEY=

# ─── Admin & Security ─────────────────────────────────────────────────────
# Secret for admin API endpoints. If unset, admin endpoints are disabled.
ADMIN_SECRET=

# Comma-separated list of IPs allowed to access admin endpoints.
# ADMIN_ALLOWED_IPS=127.0.0.1

# ─── Paths (auto-created if missing) ──────────────────────────────────────
# DB_PATH=./mathu-bot.db
# LOG_DIR=./logs
# SCREENSHOT_DIR=./logs/screenshots
# USER_DATA_DIR=./.browser-data

# ─── Telegram Alerts (optional) ───────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── Email Alerts / SMTP (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
# ALERT_EMAIL_TO=

# ─── ntfy Alerts (optional) ───────────────────────────────────────────────
# NTFY_TOPIC=

# ─── Slack Alerts (optional) ──────────────────────────────────────────────
# SLACK_WEBHOOK_URL=

# ─── Proxy (optional) ────────────────────────────────────────────────────
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# ─── Captcha Solving (optional) ──────────────────────────────────────────
# CAPTCHA_SERVICE=none
# CAPTCHA_API_KEY=

# ─── Remote Config (optional) ────────────────────────────────────────────
# REMOTE_CONFIG_URL=

# ─── Remote Brain (optional) ─────────────────────────────────────────────
# REMOTE_BRAIN_URL=
# BRAIN_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# ADVANCED / FINE-TUNING (all have sensible defaults)
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────
# APP_URL=https://app.mathu.co.za/
# CHROMIUM_EXECUTABLE_PATH=

# ─── Browser & Interaction Timing ────────────────────────────────────────
# HEADLESS=true
# POST_CLICK_MS=20000
# BETWEEN_STEPS_MS=25000
# SCROLL_PAUSE_MS=20000
# SCROLL_AMOUNT=800
# VIDEO_SPEED=16
# VIDEO_TIMEOUT_MS=90000
# HUMAN_MOUSE_JITTER_PX=3
# HUMAN_MOUSE_STEPS=5
# SWIPE_DURATION_MS=800
# LONG_PRESS_DELAY_MS=600

# ─── Cycle & Runtime Limits ──────────────────────────────────────────────
# MAX_QUESTIONS=999999
# MAX_CONSECUTIVE_SAME_ACTION=5
# SCROLL_NO_CHANGE_THRESHOLD=2
# AUTH_TIMEOUT_MS=450000
# MAX_AUTH_ATTEMPTS=30
# CAPTCHA_MAX_ATTEMPTS=3
# PROGRESS_TIMEOUT_MS=1800000
# MAX_RUNTIME_PER_CYCLE_MS=7200000
# CHECK_INTERVAL_HOURS=12
# MAX_BACKOFF_MULTIPLIER=16
# MAX_CYCLES_BEFORE_RESTART=100
# MAX_UPTIME_HOURS=24
# WAIT_MULTIPLIER=1.0

# ─── Memory Management ───────────────────────────────────────────────────
# MAX_MEMORY_MB=512
# MEMORY_WARNING_THRESHOLD_MB=400
# MEMORY_RESTART_THRESHOLD_MB=480
# ENABLE_GC_ON_CYCLE=true

# ─── Status Server & Dashboard ───────────────────────────────────────────
# STATUS_PORT=8080
# ENABLE_STATUS_SERVER=true
# DASHBOARD_PORT=8080
# REPLIT_VM=false

# ─── Logging ──────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# LOG_MAX_SIZE_MB=50
# LOG_MAX_FILES=5
# LOG_ROTATE_INTERVAL=1d

# ─── Screenshots ──────────────────────────────────────────────────────────
# SAVE_SCREENSHOTS=false
# MAX_SCREENSHOTS=10

# ─── State & Persistence ──────────────────────────────────────────────────
# STATE_HISTORY_MAX=100
# STATE_TIMEOUT_MS=300000
# HEARTBEAT_FILE=.heartbeat
# HEARTBEAT_INTERVAL_MS=60000
# CHECKPOINT_FILE=checkpoint.json
# PROGRESS_LOG_PATH=./logs/progress.jsonl
# LAST_STATE_PATH=./last-state.json

# ─── Sleep Schedule (Johannesburg timezone assumed) ───────────────────────
# SLEEP_MIN_HOURS=10
# SLEEP_MAX_HOURS=16
# STARTUP_DELAY_MIN_MINUTES=15
# STARTUP_DELAY_MAX_MINUTES=45
# WARMUP_PROBABILITY=0.3
# ALLOWED_ACTIVITY_START_HOUR=7
# ALLOWED_ACTIVITY_END_HOUR=22

# ─── Updater ──────────────────────────────────────────────────────────────
# UPDATER_ENABLED=true
# UPDATER_INTERVAL_HOURS=168
# UPDATER_TIMEOUT_MS=120000
# ENABLE_UI_PROMPT_UPDATER=true
# UI_PROMPT_UPDATE_INTERVAL_DAYS=30

# ─── IP / Geo Fencing ─────────────────────────────────────────────────────
# ENABLE_IP_CHECK=true
# EXPECTED_IP_CITY=Johannesburg
# EXPECTED_IP_COUNTRY=South Africa

# ─── Alerts ───────────────────────────────────────────────────────────────
# ALERT_ON_ERROR=true
# ALERT_ON_STAGNATION=true
# ALERT_ON_AUTH_FAILURE=true

# ─── Circuit Breakers ─────────────────────────────────────────────────────
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT_MS=600000

# ─── Self-Heal Core ───────────────────────────────────────────────────────
# SELF_HEAL_ENABLED=true
# SELF_HEAL_FAILURE_THRESHOLD=5
# SELF_HEAL_MAX_ATTEMPTS=3
# SELF_HEAL_DEBUG_ATTEMPTS=3
# SELF_HEAL_MAX_BACKUPS=5
# SELF_HEAL_TEST_DEPTH=5
# SELF_HEAL_MANUAL_OVERRIDE=
# SELF_HEAL_ALLOW_ALL=
# EXTENDED_CHECKPOINT_ENABLED=true

# ─── Self-Heal Subsystems ─────────────────────────────────────────────────
# PREDICTIVE_HEAL_ENABLED=true
# PREDICTIVE_HEAL_LATENCY_SPIKE_THRESHOLD=2.0
# PREDICTIVE_HEAL_CLICK_DROP_THRESHOLD=0.3
# SELECTOR_DRIFT_HEAL_ENABLED=true
# REGRESSION_BANK_ENABLED=true
# CANARY_ROLLOUT_ENABLED=true
# CANARY_OBSERVATION_HOURS=6
# CANARY_ERROR_RATE_MULTIPLIER=2.0
# DIFF_MINIMIZER_ENABLED=true
# ADVERSARIAL_TESTER_ENABLED=true
# CRITICAL_SHADOW_MODE_ENABLED=true
# DB_HEALER_ENABLED=true
# DB_HEALER_QUARANTINE_MAX_AGE_DAYS=30
# AUTH_HEALER_ENABLED=true
# AUTH_HEALER_MAX_FAILURES=3
# STATE_RECOVERY_ENABLED=true
# STATE_RECOVERY_PROMOTE_AFTER=3
# STATE_RECOVERY_TTL_DAYS=7
# DEPENDENCY_HEALER_ENABLED=true
# CONFIG_RECONCILER_ENABLED=true
# PATCH_MEMORY_ENABLED=true
# PATCH_MEMORY_TOP_K=5
# HEAL_REWARD_TRACKER_ENABLED=true
# SELF_HEAL_TIMELINE_ENABLED=true
# HEALER_SELF_TEST_ENABLED=true
# HEALER_SELF_TEST_INTERVAL_HOURS=168
# HEALER_CIRCUIT_BREAKER_ENABLED=true
# HEALER_CB_FAILURE_RATE=0.7
# HEALER_CB_SLIDING_WINDOW=10
# SUBSYSTEM_CB_MESH_ENABLED=true
# CLEAN_ROOM_TEST_ENABLED=true
# CLEAN_ROOM_TEST_INTERVAL_HOURS=168
# DEGRADATION_LADDER_ENABLED=true
# BLACKBOX_FULL_ENABLED=true
# BLACKBOX_FULL_MAX_ENTRIES=20

# ─── Prompt Evolution ─────────────────────────────────────────────────────
# PROMPT_EVOLUTION_ENABLED=true
# PROMPT_EVOLUTION_MIN_ENTRIES=100

# ─── Code-Generation Models ───────────────────────────────────────────────
# CODE_GEN_MODEL_MISTRAL=codestral-latest
# CODE_GEN_MODEL_QWEN=qwen-coder-plus
# CODE_GEN_MODEL_DEEPSEEK=deepseek-coder
# CODE_GEN_MODEL_OPENROUTER=openrouter/free
# CODE_GEN_CONSENSUS_THRESHOLD=5

# ─── Provider Budgets (USD) ───────────────────────────────────────────────
# PROVIDER_BUDGET_OPENROUTER=0.5
# PROVIDER_BUDGET_MISTRAL=0.2
# PROVIDER_BUDGET_GITHUB=0.1
# BARGAIN_HUNTER_INTERVAL_HOURS=6

# ─── OpenRouter Daily Request Limit ──────────────────────────────────────
# OpenRouter is our most reliable provider but we get 50 requests/day.
# When exhausted, the bot continues with Cloudflare/Gemini/Groq/etc.
# If NO other providers are available, it sleeps until UTC midnight and resumes.
# Set to 0 for unlimited. Counter resets at UTC midnight.
# OPENROUTER_DAILY_LIMIT=50

# ─── OpenRouter Rate Limiter (advanced) ──────────────────────────────────
# Priority budget split (percentage of daily limit):
# OR_CRITICAL_QUOTA_PCT=50    # Tribunal + codegen (most important)
# OR_STANDARD_QUOTA_PCT=35   # Self-heal, model evolution, meta-learner
# Low priority gets the remainder (15% by default)
#
# Pacing: spread requests evenly across 24 hours (advisory, critical bypasses)
# OR_PACING_ENABLED=true
#
# When exhausted + no other providers: sleep until midnight (cap: 30 min checks)
# OR_SLEEP_ON_EXHAUSTED=true

# ─── Provider Ordering ────────────────────────────────────────────────────
# PROVIDER_ORDER=
# PROVIDER_HEALTH_CHECK_INTERVAL_MS=3600000
# VISION_PRIORITY=cloud

# ─── Database ─────────────────────────────────────────────────────────────
# TEMPLATE_CACHE_ENABLED=true
# TEMPLATE_MATCH_THRESHOLD=0.85
# OCR_FALLBACK_ENABLED=true

# ─── Model Evolution ──────────────────────────────────────────────────────
# EVOLUTION_INTERVAL_DAYS=30

# ─── GitOps ───────────────────────────────────────────────────────────────
# GITOPS_ENABLED=true
# GITOPS_ROLLBACK_DEPTH=10

# ─── Captcha ──────────────────────────────────────────────────────────────
# CAPTCHA_QUEUE_MAX=5
# CAPTCHA_HUMAN_TIMEOUT_MS=300000

# ─── UI Drift Detection ───────────────────────────────────────────────────
# UI_DRIFT_THRESHOLD=10

# ─── Brute Force Navigator ────────────────────────────────────────────────
# BRUTE_FORCE_MAX_TRIES=50

# ─── Dependency Management ────────────────────────────────────────────────
# AUTO_FIX_DEPENDENCIES=true
# AUTO_INSTALL_DEPENDENCIES=false
# FORCE_NODE_VERSION=v20.11.0

# ─── Flutter Support ──────────────────────────────────────────────────────
# ENABLE_FLUTTER_SEMANTICS=true
# ENABLE_NETWORK_INTERCEPT=true
# ENABLE_CANVAS_OCR=true
# FLUTTER_DPR_AUTO_CALIBRATE=true
# NETWORK_REPLAY_ON_CLICK_FAIL=true

# ─── Blackbox Recorder ────────────────────────────────────────────────────
# ENABLE_BLACKBOX=true
# BLACKBOX_MAX_ENTRIES=50

# ─── Adaptive Performance ─────────────────────────────────────────────────
# ENABLE_ADAPTIVE_PERFORMANCE=true
# PERFORMANCE_BASELINE_MS=500

# ─── Protocol Chameleon ───────────────────────────────────────────────────
# ENABLE_PROTOCOL_CHAMELEON=true

# ─── GAN Telemetry (experimental) ─────────────────────────────────────────
# ENABLE_GAN_TELEMETRY=false
# GAN_MODEL_PATH=./models/mouse-gan.onnx

# ─── Exploration ───────────────────────────────────────────────────────────
# ENABLE_EXPLORATION_PASS=true
# EXPLORATION_CONSECUTIVE_FAILURES=3

# ─── Local VLM (optional, requires onnxruntime-node) ─────────────────────
# ENABLE_LOCAL_VLM=false
# LOCAL_VLM_MODEL=onnx-community/Phi-3.5-vision-instruct-ONNX

# ─── Puzzle Sandbox ────────────────────────────────────────────────────────
# ENABLE_PUZZLE_SANDBOX=false

# ─── Runtime Guardian ─────────────────────────────────────────────────────
# ENABLE_RUNTIME_GUARDIAN=true
# RUNTIME_MANIFEST_URL=

# ─── Feature Flags ────────────────────────────────────────────────────────
# SANDBOX_MODE=false
# WEB_SEARCH_ENABLED=true
# SELF_DEPLOY_ENABLED=false
# POLICY_ENFORCED=true
# POLICY_BLOCKED_DOMAINS=
